{
  "name": "videopilot-pro",
  "version": "1.0.0",
  "author": "VideoPilot Pro Team",
  "description": "VideoPilot Pro Universal Downloader PC Edition",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "start": "node server/index.js",
    "desktop": "electron desktop/main.js",
    "build:exe": "npm run build:client && electron-builder --win"
  },
  "build": {
    "appId": "com.videopilot.pro",
    "productName": "VideoPilot Pro",
    "files": [
      "desktop/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist_installer"
    },
    "win": {
      "target": ["portable", "nsis"],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VideoPilot Pro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PhelobaterFady",
        "repo": "VideoPilotPRO"
      }
    ]
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  }
}
