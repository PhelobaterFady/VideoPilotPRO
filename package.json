{
  "name": "videopilot-pro",
  "version": "1.3.1",
  "author": "Video Pilot Pro Team",
  "description": "Video Pilot Pro Universal Downloader PC Edition",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "desktop": "electron desktop/main.js",
    "build:exe": "npm run build:client && electron-builder --win",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "com.videopilot.pro",
    "productName": "Video Pilot Pro",
    "directories": {
      "output": "dist_installer"
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Pilot Pro",
      "differentialPackage": true,
      "packElevateHelper": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PhelobaterFady",
        "repo": "VideoPilotPRO"
      }
    ]
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  }
}
